# Django Settings
SECRET_KEY=django-insecure-replace-this-key-for-production
DEBUG=True
ALLOWED_HOSTS=*
WEB_PORT=8080

# PostgreSQL + pgvector
POSTGRES_USER=research_user
POSTGRES_PASSWORD=research_password
POSTGRES_DB=research_commons
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://research_user:research_password@127.0.0.1:5433/research_commons

# MinIO S3 Object Storage (Lakehouse & Parquet Warehouse)
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=admin12345
MINIO_ENDPOINT=localhost:9000
MINIO_SECURE=False
MINIO_BUCKET_RAW=chanakya-lakehouse
MINIO_BUCKET_PARQUET=analytics-parquet

# Ollama Local LLM & Sentence Transformers Embeddings
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2
EMBEDDING_MODEL=all-MiniLM-L6-v2
